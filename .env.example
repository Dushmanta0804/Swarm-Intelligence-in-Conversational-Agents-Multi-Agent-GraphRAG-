# Copy to .env and fill in when you have services/keys
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=swarm_password
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=swarm_docs
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1  # uncomment for Groq
OPENAI_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODE=local
GRAPH_BACKEND=local
# ---- Phase 3: GPT + RAG Agent ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=800
RAG_SYSTEM_PROMPT=You are a Swarm Intelligence GraphRAG agent. Answer using ONLY the provided evidence from the knowledge graph swarm. If the evidence is insufficient, say so clearly. Always cite evidence chunks by quoting them. Be concise but complete.

# ---- Phase 2 swarm ----
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false
PRUNE_THRESHOLD=0.60
MAX_HOPS=3
MAX_WORKERS=8
TOP_K_SCOUT=5
PHEROMONE_DECAY=0.9
PHEROMONE_DEPOSIT=1.0

